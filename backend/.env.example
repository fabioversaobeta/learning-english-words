PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/english_db
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# production | development. Controls cookie `secure` flag and whether error
# responses include the raw error message.
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
# Only needed for cross-site setups (see README "Same-origin via rewrites da
# Vercel") or for local dev on a port not already in the default list.
# FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3010
