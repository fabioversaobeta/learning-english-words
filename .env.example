ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if the API key is not scoped to a workspace. Leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=

# Portas usadas no host pelo docker-compose. Ajuste aqui se algum desses
# valores colidir com outro projeto/container já rodando na sua máquina.
FRONTEND_PORT=3010
BACKEND_PORT=3001
DB_PORT=5433
